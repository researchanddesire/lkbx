// Production Boost.SML rows, included inside make_transition_table in LKBX.h
// and in the native fixture with hardware actions replaced by counters.
// Preflight acknowledges physical acceptance once. Reconciliation never moves
// the motor, sends a lock report, or steals focus from a menu/emergency/break.
"locking.preflight"_s + done[isEmergencyBlocked] = "emergency.blocked"_s,
"locking.preflight"_s + done[isLocked && isFrozen] / sendMessage(Str::Protocol::LOCKED) = "locked.frozen"_s,
"locked"_s + freezeState[isFrozen] = "locked.frozen"_s,
"locked"_s + freezeState[isLockedTimer] = "locked.timer"_s,
"locked.timer"_s + freezeState[isFrozen] = "locked.frozen"_s,
"locked.timer"_s + freezeState[!isLockedTimer] = "locked"_s,
"locked.timer"_s + freezeState[isReadyToUnlock] = "locked.ready"_s,
"locked.ready"_s + freezeState[isFrozen] = "locked.frozen"_s,
"locked.ready"_s + freezeState[!isLockedTimer] = "locked"_s,
"locked.ready"_s + freezeState[!isReadyToUnlock] = "locked.timer"_s,
"locked.ready.addTime"_s + freezeState[isFrozen] = "locked.frozen"_s,
"locked.ready.addTime"_s + freezeState[!isLockedTimer] = "locked"_s,
"locked.ready.addTime"_s + freezeState[!isReadyToUnlock] = "locked.timer"_s,
"locked.frozen"_s + on_entry<_> / (drawLockedActions, startUnlockTimer),
"locked.frozen"_s + buttonPress = "lockMenu"_s,
"locked.frozen"_s + freezeState[!isFrozen && isReadyToUnlock] = "locked.ready"_s,
"locked.frozen"_s + freezeState[!isFrozen && isLockedTimer] = "locked.timer"_s,
"locked.frozen"_s + freezeState[!isFrozen] = "locked"_s,
"locked.frozen"_s + locktimer / switchToTimer,
"locked.frozen"_s + lock / switchToLock,
"locked.frozen"_s + lockOffered / (clearActiveBreak, movePaddleToUnlock) = "acceptLock"_s,
"locked.frozen"_s + unlock / (clearLocalPlay, unlockAction) = "locking"_s,
"locked.frozen"_s + breakE = "locked.break"_s,
"locked.frozen"_s + forceUpdate = "update"_s,
"locked.return"_s + on_entry<_> / returnToLockScreen,
"locked.return"_s + done[isFrozen] = "locked.frozen"_s,
"locked.return"_s + done[isReadyToUnlock] = "locked.ready"_s,
"locked.return"_s + done[isLockedTimer] = "locked.timer"_s,
"locked.return"_s + done = "locked"_s,
"lockMenu"_s + backPress = "locked.return"_s,
"lockMenu"_s + buttonPress[(isOption(MenuItemE::BACK))] = "locked.return"_s,
